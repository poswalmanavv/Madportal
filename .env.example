# Copy to .env.local and fill in real values. Never commit .env.local.
# Save as UTF-8 WITHOUT a BOM: node --env-file misparses a leading BOM and silently drops
# the first variable.

# SQLite via libSQL.
#   Local:      a real SQLite file on disk
#   Production: a Turso database (SQLite served over HTTP, so it survives serverless)
#
# A plain file: URL will NOT work on Netlify -- the filesystem is read-only and containers
# are thrown away between requests, so the data would vanish. Production must be Turso.
DATABASE_URL=file:./data/mad-club.db

# Required only for a libsql:// (Turso) URL. Leave empty for a local file.
# Get it with: turso db tokens create mad-club
DATABASE_AUTH_TOKEN=

# Session signing secret. Generate with: openssl rand -base64 32
# NextAuth v5 reads AUTH_SECRET; NEXTAUTH_SECRET is the v4 name kept as a fallback.
# Set BOTH to the SAME value. Use a fresh secret in production.
AUTH_SECRET=replace-me
NEXTAUTH_SECRET=replace-me

# Canonical URL of the deployment, no trailing slash. Must be the real origin in production
# (e.g. https://maddashbaord.netlify.app) or auth callbacks redirect to the wrong host.
NEXTAUTH_URL=http://localhost:3000

# Comma-separated allowlist. These emails, and only these, are granted the secretary role on
# registration and may sign in through /login/admin.
AUTHORIZED_SECRETARIES=secretary@nitkkr.ac.in

# Optional. Overrides the default password used by `pnpm seed` in local development.
# SEED_PASSWORD=
