# Copy to .env.local and fill in real values. Never commit .env.local.
# Save this file as UTF-8 WITHOUT a BOM: node --env-file misparses a leading BOM and
# silently drops the first variable.

# MongoDB connection string.
# Local:      mongodb://127.0.0.1:27017
# Production: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# The database name is NOT taken from this URI -- the app always uses "mad-club"
# (see DB_NAME in src/lib/db.ts).
MONGODB_URI=mongodb://127.0.0.1:27017

# Session signing secret. Generate with: openssl rand -base64 32
# NextAuth v5 reads AUTH_SECRET; NEXTAUTH_SECRET is the v4 name kept as a fallback.
# Set BOTH to the SAME value. Use a fresh secret in production.
AUTH_SECRET=replace-me
NEXTAUTH_SECRET=replace-me

# Canonical URL of the deployment. Must match the real origin in production
# (e.g. https://madclub.netlify.app) or auth callbacks will redirect to the wrong host.
NEXTAUTH_URL=http://localhost:3000

# Comma-separated allowlist. These emails, and only these, are granted the secretary role
# on registration and may sign in through /login/admin.
AUTHORIZED_SECRETARIES=secretary@nitkkr.ac.in

# Optional. Overrides the default seed password used by `pnpm seed` in local development.
# SEED_PASSWORD=
