# Credentials for the LIVE Turso database.
#
# Copy this file to `.env.turso` (drop the .example) and paste your real token in.
# `.env.turso` is gitignored -- never commit it.
#
# It is used by ONE command:
#
#   pnpm db:migrate:turso     creates the tables in the live database
#
# It is deliberately separate from .env.local so that running the app, the seed script or
# the tests can never accidentally point at production.

DATABASE_URL=libsql://mad-club-poswalmanavv.aws-ap-south-1.turso.io
DATABASE_AUTH_TOKEN=paste-the-token-from-turso-here
